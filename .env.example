DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/store

SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters

FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
# Secret webhook défini dans le dashboard FedaPay — active la vérification de signature
FEDAPAY_WEBHOOK_SECRET=

# Password reset emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="SILVIO STORE <no-reply@your-domain.com>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob (stockage des médias : images produits, bannières, marques, site)
# Générée automatiquement par Vercel quand un Blob store est créé et lié au projet.
# En local : `vercel env pull .env` après avoir lié le projet, ou copier la valeur
# depuis Vercel > Project > Storage > (ton Blob store) > .env.local tab.
BLOB_READ_WRITE_TOKEN=
